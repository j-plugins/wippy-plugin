<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.xepozz.wippy</id>
    <name>Wippy</name>
    <vendor>xepozz</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="language-json.xml">com.intellij.modules.json</depends>
    <depends optional="true" config-file="language-yaml.xml">org.jetbrains.plugins.yaml</depends>
    <depends optional="true" config-file="wippy-lsp.xml">com.intellij.modules.lsp</depends>

    <resource-bundle>messages.MyBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
                name="WippyLua"
                implementationClass="com.github.xepozz.wippy.lang.WippyLuaFileType"
                fieldName="INSTANCE"
                language="WippyLua"
                extensions="lua"/>
        <lang.parserDefinition
                language="WippyLua"
                implementationClass="com.github.xepozz.wippy.lang.WippyLuaParserDefinition"/>
        <lang.syntaxHighlighterFactory
                language="WippyLua"
                implementationClass="com.github.xepozz.wippy.lang.WippyLuaSyntaxHighlighterFactory"/>
        <colorSettingsPage
                implementation="com.github.xepozz.wippy.lang.WippyLuaColorSettingsPage"/>
        <lang.braceMatcher
                language="WippyLua"
                implementationClass="com.github.xepozz.wippy.lang.WippyLuaBraceMatcher"/>
        <lang.commenter
                language="WippyLua"
                implementationClass="com.github.xepozz.wippy.lang.WippyLuaCommenter"/>
        <lang.foldingBuilder
                language="WippyLua"
                implementationClass="com.github.xepozz.wippy.lang.WippyLuaFoldingBuilder"/>
        <lang.elementManipulator
                forClass="com.github.xepozz.wippy.lang.psi.impl.WippyLuaElementImpl"
                implementationClass="com.github.xepozz.wippy.lang.WippyElementManipulator"/>
        <annotator
                language="WippyLua"
                implementationClass="com.github.xepozz.wippy.lang.WippyAnnotator"/>

        <spellchecker.bundledDictionaryProvider
                implementation="com.github.xepozz.wippy.SpellcheckingDictionaryProvider"/>

        <executionTargetLanguageRuntimeType
                implementation="com.github.xepozz.wippy.run.WippyRuntimeType"/>
<!--        <backgroundPostStartupActivity-->
<!--                implementation="com.github.xepozz.wippy.project.WippySourceRootConfigurator"/>-->
        <!--        <moduleBuilder-->
        <!--                builderClass="com.github.xepozz.wippy.project.module.MoonshineModuleBuilder"/>-->
        <!--        <moduleBuilder builderClass="com.github.xepozz.wippy.project.module.WippyModuleBuilder" />-->
        <moduleType id="wippy"
                    implementationClass="com.github.xepozz.wippy.project.module.WippyModuleType"/>

        <vfs.asyncListener
                implementation="com.github.xepozz.wippy.project.WippyLockFileListener"/>
        <notificationGroup id="Wippy" displayType="BALLOON"/>

        <applicationService
                serviceImplementation="com.github.xepozz.wippy.lsp.WippyLspSettings"/>


        <customUsageSearcher
                implementation="com.github.xepozz.wippy.reference.WippyLuaFunctionUsageSearcher"/>

        <configurationType
                implementation="com.github.xepozz.wippy.run.WippyRunConfigurationType"/>
        <runConfigurationProducer
                implementation="com.github.xepozz.wippy.run.WippyRunConfigurationProducer"/>

        <fileBasedIndex
                implementation="com.github.xepozz.wippy.index.WippyEntryIndex"/>

        <iconProvider implementation="com.github.xepozz.wippy.icons.WippyTestFileIconProvider"/>

        <applicationService
                serviceImplementation="com.github.xepozz.wippy.tool.WippyToolSettings"/>

        <applicationConfigurable
                groupId="tools"
                instance="com.github.xepozz.wippy.tool.WippyToolConfigurable"
                id="com.github.xepozz.wippy.tool.WippyToolConfigurable"
                displayName="Wippy"/>

        <roots.watchedRootsProvider implementation="com.github.xepozz.wippy.project.MyWatchedRootsProvider"/>
        <runLineMarkerContributor
                language="WippyLua"
                implementationClass="com.github.xepozz.wippy.reference.WippyLuaFunctionRunLineMarkerContributor"/>

        <sdkType implementation="com.github.xepozz.wippy.sdk.WippySdkType"/>
        <highlightUsagesHandlerFactory implementation="com.github.xepozz.wippy.highlighting.WippyLuaHighlightUsagesHandlerFactory"/>
    </extensions>

    <actions>
        <group id="Wippy.ToolsMenu" text="Wippy" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action
                    id="Wippy.Rescan"
                    class="com.github.xepozz.wippy.project.WippyRescanAction"
                    text="Rescan Projects"
                    description="Detect Wippy projects and configure source roots"/>
        </group>
    </actions>
</idea-plugin>
