<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <fileType
                name="Wippy Lock File"
                implementationClass="com.github.xepozz.wippy.WippyLockFileType"
                fieldName="INSTANCE"
                language="yaml"
                patterns="*.wippy.lock;wippy.lock;wippy.*.lock"
                fileNamesCaseInsensitive="wippy.lock"
        />
        <fileType
                name="Wippy File"
                implementationClass="com.github.xepozz.wippy.WippyFileType"
                fieldName="INSTANCE"
                language="yaml"
                patterns="*.wippy.yaml"
                fileNamesCaseInsensitive=".wippy.yaml"
        />

        <fileBasedIndex implementation="com.github.xepozz.wippy.index.WippyConfigIndex"/>

        <psi.referenceContributor
                language="yaml"
                implementation="com.github.xepozz.wippy.reference.WippyFileReferenceContributor"/>

        <codeInsight.lineMarkerProvider
                language="yaml"
                implementationClass="com.github.xepozz.wippy.reference.WippySourceLineMarkerProvider"/>

        <annotator
                language="yaml"
                implementationClass="com.github.xepozz.wippy.reference.WippyFileReferenceAnnotator"/>

        <psi.referenceContributor
                language="yaml"
                implementation="com.github.xepozz.wippy.reference.WippyMethodReferenceContributor"/>

        <codeInsight.lineMarkerProvider
                language="yaml"
                implementationClass="com.github.xepozz.wippy.reference.WippyMethodLineMarkerProvider"/>

        <runLineMarkerContributor
                language="yaml"
                implementationClass="com.github.xepozz.wippy.run.WippyConfigRunLineMarkerContributor"/>

        <codeInsight.lineMarkerProvider
                language="yaml"
                implementationClass="com.github.xepozz.wippy.hub.WippyHubLineMarkerProvider"/>

        <intentionAction>
            <language>yaml</language>
            <className>com.github.xepozz.wippy.hub.WippyOpenHubIntention</className>
            <category>Wippy</category>
        </intentionAction>
    </extensions>
</idea-plugin>
