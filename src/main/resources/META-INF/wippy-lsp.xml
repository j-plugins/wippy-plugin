<!-- Optional module: loaded only when the IntelliJ LSP API (com.intellij.modules.lsp, Ultimate) is present. -->
<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <platform.lsp.serverSupportProvider
                implementation="com.github.xepozz.wippy.lsp.WippySocketLspServerSupportProvider"/>

        <applicationConfigurable
                parentId="com.github.xepozz.wippy.tool.WippyToolConfigurable"
                instance="com.github.xepozz.wippy.lsp.WippyLspConfigurable"
                id="com.github.xepozz.wippy.lsp.settings.WippyLspConfigurable"
                displayName="LSP"/>
    </extensions>

    <actions>
        <action
                id="Wippy.RestartLsp"
                class="com.github.xepozz.wippy.lsp.RestartLspAction"
                text="Restart Wippy LSP"
                description="Restart Wippy LSP server connection">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
